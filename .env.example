# Copy to .env and fill in your credentials:
#   cp .env.example .env

# OpenAI-compatible API (used by reward judge and format checks)
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (optional fallback judge)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# DeepSeek (optional, for benign response generation scripts)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Experiment logging (optional)
SWANLAB_API_KEY=

# Hugging Face mirror (optional, e.g. for restricted networks)
HF_ENDPOINT=

# Reward logging directory (set automatically by training scripts)
# EXPERIMENT_LOG_DIR=
